{"version":2,"kind":"Article","sha256":"d407483ea1b18ba5e5b24bc7aec0b9706191533a722c3bbd2fbab4151c11ff98","slug":"introduction-1","location":"/apologists/introduction.md","dependencies":[],"frontmatter":{"title":"Apologists","subtitle":"Mission According to the Desert Fathers","date":"2025-09-15","authors":[{"nameParsed":{"literal":"Eric Araujo","given":"Eric","family":"Araujo"},"name":"Eric Araujo","corresponding":true,"email":"eric.araujo@calvin.edu","id":"contributors-myst-generated-uid-0"}],"numbering":{"title":{"offset":2}},"exports":[{"format":"md","filename":"introduction.md","url":"/introduction-248d6549be9f22ee30b3f68936ee9753.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The documents from the first century and first half of the second century are more focused on dealing with internal church matters and the teachings of Jesus and the apostles. However, starting in the mid-second century, we see the emergence of a distinct genre of Christian literature known as “apologies” or “apologetics.”","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"IIafJTondK"}],"key":"NkuqLcPArq"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Apologists were Christian writers who sought to defend and explain the Christian faith to both non-Christians and Christians alike. Their writings often addressed criticisms and misconceptions about Christianity, as well as providing a rational basis for belief in Jesus Christ and the Christian message.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"iTStizKANf"}],"label":"apologists","identifier":"apologists","html_id":"apologists","key":"LoECIhZ1Jl"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"This lecture focused on the Desert Fathers and their approach to Christian mission. The Desert Fathers were early Christian hermits, ascetics, and monks who lived often in the deserts.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Y29MQlDZBL"}],"key":"Lu99WKg7iP"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"The list of apologists from the 2nd and 3rd centuries included:","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"IaysWHTAdh"}],"key":"rit8fZ6kki"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":16,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Justin Martyr (c. 100–165 AD)","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"D8fvd2yuRJ"}],"key":"OE6g0oAF3U"}],"key":"RdNj2u6sHJ"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Quadratus (fl. c. 124–132 AD)","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"HJQCdijHHm"}],"key":"x4ZkDDOJ9p"}],"key":"bTYnfs7sY1"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Aristides of Athens (c. 100–c. 165 AD)","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"OWES1LablL"}],"key":"Wxy6HISR8b"}],"key":"SRcfGnc8Ky"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tatian (c. 120–c. 180 AD)","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"nqYa9SSG9d"}],"key":"D3mkIFLv2p"}],"key":"t07Gb0hvmN"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Melito of Sardis (fl. mid-2nd century AD)","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ybfSVcPczZ"}],"key":"NY57Wwi5Ml"}],"key":"jn1icImALE"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Athenagoras of Athens (c. 133–c. 190 AD)","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"qJBEJdpoVj"}],"key":"IZn6rEAf3w"}],"key":"FEdXZ3g97K"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Theophilus of Antioch (c. 120–c. 190 AD)","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"VCIz9ANOsP"}],"key":"lFcMXO5uuG"}],"key":"aReQg4xxz5"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tertullian (c. 155–c. 240 AD)","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"nszDC47pYC"}],"key":"TppubcODNV"}],"key":"HTNA5MQY8G"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Clement of Alexandria (c. 150–c. 215 AD)","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ZWV6XoDr3r"}],"key":"uhxh68qV0g"}],"key":"PbvnDLwjtP"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Origen (c. 184–c. 253 AD)","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"g1cstVlCvN"}],"key":"SW0dvkh5AD"}],"key":"PJSRGtj7gk"}],"key":"v2AN6toXwy"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"This is list is not exhaustive, but it includes some of the most prominent figures who contributed to the development of Christian theology and defended the faith against various criticisms during this period.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"mHYOXH0qO8"}],"key":"Z8v20ZX1VJ"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Purpose of Apologies","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"yNNIvYK3f0"}],"identifier":"purpose-of-apologies","label":"Purpose of Apologies","html_id":"purpose-of-apologies","implicit":true,"key":"bVJNw8nkub"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"The primary purposes of these apologies were:","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"nn0ru13cgG"}],"key":"UjwmvKpvev"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":33,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To defend Christianity against accusations and misconceptions held by both pagan and Jewish critics. (defensive)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"mnHh2PbXds"}],"key":"YL78kF2Skt"}],"key":"Pwe3OCiy22"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To advance the understanding of Christian beliefs and practices among non-Christians. (offensive)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"PaxqWioHiw"}],"key":"t8AJVqJjzr"}],"key":"Li8Slpls2w"},{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To demonstrate the reasonableness and moral superiority of the Christian faith. (evangelistic)","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"q7Imx1xiRl"}],"key":"gptxooXk8c"}],"key":"PMHWPn8YiQ"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To encourage and strengthen the faith of Christian believers in the face of persecution and societal pressure. (constructive)","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"rGLGYK81kj"}],"key":"rKxrYAX9zM"}],"key":"Qs1U7YcRmZ"}],"key":"d0l6MFUCvv"},{"type":"heading","depth":2,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Justin Martyr (c. 100–165 AD)","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"se6UzlrcKl"}],"identifier":"justin-martyr-c-100-165-ad","label":"Justin Martyr (c. 100–165 AD)","html_id":"justin-martyr-c-100-165-ad","implicit":true,"key":"kj06eVYDYd"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Justin Martyr is one of the most well-known early Christian apologists. He wrote several works defending Christianity, including “First Apology” and “Second Apology.” In these writings, Justin addressed the Roman authorities and the general public, explaining Christian beliefs and practices while refuting common accusations against Christians, such as atheism and immorality.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"E8X3G64iSe"}],"label":"justin_martyr","identifier":"justin_martyr","html_id":"justin-martyr","key":"S4MG2ObylO"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Martyr welcomed classical philosophy, particularly Platonism, as a way to understand and articulate Christian doctrine. He believed that truth could be found in both Christian revelation and philosophical inquiry.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"DdIveC559j"}],"key":"FuCJPrrIcO"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Martyr and Plato","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"qwGuv0v4Zu"}],"key":"R9j1fB7Y7I"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Justin Martyr welcomed classical philosophy. He believed that Plato’s teaching on eternal forms referred to the God of the Bible, that Socrates, (like Abraham) was ‘a Christian before Christ’, and that Socrates’ death was an example for Christian martyrs.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"w4YVaHQI3q"}],"key":"pTR0sxMO7L"}],"key":"Lg7J4bp9Tw"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"He was a gentile born in Samaria, converted to Christianity, and was eventually martyred for his faith. He was trained in Greek philosophy before his conversion. Martyr moved to Rome after his conversion, where he established a Christian school and engaged in public debates with pagan philosophers.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"it1xwO33d9"}],"key":"ZxEx3A8XXe"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"His work in the “First Apology” focus on the connection between the Old Testament and Jesus as the Messiah, arguing that Christianity was the fulfillment of Jewish prophecy. He also addressed ethical teachings, emphasizing the moral superiority of Christian living compared to pagan practices.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"GsrdxtVe4X"}],"key":"JGT0IudIqD"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"📚 Further Reading on Justin Martyr","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"zPlkqF3ds5"}],"key":"iv8Obwu2D0"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Chapter 7 of ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"bG4s58vcBL"},{"type":"cite","identifier":"gonzalez2010story","label":"gonzalez2010story","kind":"narrative","position":{"start":{"line":54,"column":14},"end":{"line":54,"column":32}},"children":[{"type":"text","value":"Gonzalez (2010)","key":"pZ4BxanD76"}],"enumerator":"1","key":"UoG5Ft7jn3"},{"type":"text","value":" provides a good overview of the context of the desert fathers’ lives and works.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"AaDsM547jx"}],"key":"o88I0rvx18"}],"key":"bi0U28j8iw"}],"key":"hnBDRzVzw7"}],"key":"lUDv8tzIZF"},"references":{"cite":{"order":["gonzalez2010story"],"data":{"gonzalez2010story":{"label":"gonzalez2010story","enumerator":"1","html":"Gonzalez, J. L. (2010). <i>The story of Christianity: Volume 1: The early church to the dawn of the reformation</i> (Vol. 1). Zondervan."}}}}}