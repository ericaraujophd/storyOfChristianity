{"version":2,"kind":"Article","sha256":"4994d1fe577032c3ba02c9319b24a5e9d47375ecba3576e291253278ff78087d","slug":"ignatius","location":"/apostolic-fathers/ignatius.md","dependencies":[],"frontmatter":{"title":"Ignatius of Antioch’s 7 Letters","authors":[{"nameParsed":{"literal":"Eric Araujo","given":"Eric","family":"Araujo"},"name":"Eric Araujo","id":"contributors-ignatius-generated-uid-0"}],"date":"2025-09-10","numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"ignatius.md","url":"/ignatius-4bd12c69e4116b27591c1d90b608218a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Ignatius of Antioch’s 7 Letters","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"cC0KNCC7am"}],"identifier":"ignatius-of-antiochs-7-letters","label":"Ignatius of Antioch’s 7 Letters","html_id":"ignatius-of-antiochs-7-letters","implicit":true,"key":"Frp1MVhn4m"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Ignatius of Antioch was an early Christian bishop who wrote a series of letters to various Christian communities while on his way to Rome for martyrdom around 110 AD. His letters emphasize the importance of church unity, the role of bishops, and the significance of the Eucharist. Ignatius strongly advocated for obedience to church leaders and warned against divisions within the Christian community. He also highlighted the reality of persecution and the need for Christians to remain faithful in the face of suffering.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"lsVGrPhn8S"}],"label":"ignatius","identifier":"ignatius","html_id":"ignatius","key":"qbu6oCLAbT"}],"key":"CBi9zCKS8O"}],"key":"Irs226K2Tc"},"references":{"cite":{"order":[],"data":{}}}}